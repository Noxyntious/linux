# Pixel 8 Pro (husky) bring-up, layered on zumapro_defconfig:
#   make zumapro_defconfig husky.config
#
# The husky bootloader rewrites every console= on the command line and appends
# console=null, so the kernel log never reaches the screen. Use our own
# command line instead (the initramfs location still comes from /chosen).
# arm64.nomte and id_aa64mmfr1.vh=0 are what the bootloader itself passes: the
# firmware sets up no MTE tag storage and expects no VHE. Without them the
# kernel hangs before the console (seen 2026-11-16).
# exynosdrm.quiesce_boot_decon=0: exynos DRM stops the bootloader's DECON at
# init (needed on the Pixel 9 before its DPU SysMMU is enabled). husky has no
# DPU master in its DT yet, so keep DECON running for zumapro-bootfb/fbcon.
# reboot=warm: PSCI SYSTEM_RESET2 (warm) keeps the reboot mode in PMU
# SYSIP_DAT0, so "reboot bootloader" lands in fastboot; a cold reset loses it.
CONFIG_CMDLINE="arm64.nomte id_aa64mmfr1.vh=0 reboot=warm exynosdrm.quiesce_boot_decon=0 zumapro_bootfb console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=font:TER16x32 rdinit=/init panic=0"
CONFIG_CMDLINE_FORCE=y
CONFIG_DRM_PANEL_GOOGLE_HK3=y
# Contiguous DMA memory: exynos DRM's framebuffer (dpu-fb-pool, a reusable
# shared-dma-pool) and any large dma_alloc need DMA_CMA; it was off.
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_TOUCHSCREEN_ST_FTM5=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_BCM=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=y
CONFIG_UHID=y
CONFIG_I2C_CHARDEV=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_INPUT_CS40L26_VIBRA=y
CONFIG_GPIO_S2MPG15=y
CONFIG_REGULATOR_SLG51002=y
CONFIG_VIDEO_PIXEL_CIS_BRINGUP=y
CONFIG_VIDEO_ZUMA_ISPFE_BRINGUP=y
# Exynos Modem 5300 (PCIe CH0). A module so it loads after the rootfs (and the
# efs/persist/modem_userdata mounts its firmware loader reads) is up.
CONFIG_S5300_MODEM=m
# S2MPG14/15 on-device power meters (debugfs, uW per rail): the power work.
CONFIG_S2MPG1415_METER=m
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Waydroid networking (waydroid-net.sh: LXC bridge + NAT + checksum fill) with
# Arch's iptables, which is the nft variant: nf_tables + the xtables compat
# layer, plus the legacy tables for iptables-legacy.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_MANGLE=y
