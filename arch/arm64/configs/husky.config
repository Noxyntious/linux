# Pixel 8 Pro (husky) bring-up, layered on zumapro_defconfig:
#   make zumapro_defconfig husky.config
#
# The husky bootloader rewrites every console= on the command line and appends
# console=null, so the kernel log never reaches the screen. Use our own
# command line instead (the initramfs location still comes from /chosen).
# arm64.nomte and id_aa64mmfr1.vh=0 are what the bootloader itself passes: the
# firmware sets up no MTE tag storage and expects no VHE. Without them the
# kernel hangs before the console (seen 2026-11-16).
# exynosdrm.quiesce_boot_decon=0: exynos DRM stops the bootloader's DECON at
# init (needed on the Pixel 9 before its DPU SysMMU is enabled). husky has no
# DPU master in its DT yet, so keep DECON running for zumapro-bootfb/fbcon.
# reboot=warm: PSCI SYSTEM_RESET2 (warm) keeps the reboot mode in PMU
# SYSIP_DAT0, so "reboot bootloader" lands in fastboot; a cold reset loses it.
CONFIG_CMDLINE="arm64.nomte id_aa64mmfr1.vh=0 reboot=warm exynosdrm.quiesce_boot_decon=0 zumapro_bootfb console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=font:TER16x32 rdinit=/init panic=0"
CONFIG_CMDLINE_FORCE=y
CONFIG_DRM_PANEL_GOOGLE_HK3=y
# Contiguous DMA memory: exynos DRM's framebuffer (dpu-fb-pool, a reusable
# shared-dma-pool) and any large dma_alloc need DMA_CMA; it was off.
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_TOUCHSCREEN_ST_FTM5=y
CONFIG_REGULATOR_S2MPS11=y
