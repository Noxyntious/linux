# Pixel 8 Pro (husky) with the display owned by exynos DRM + panel-google-hk3
# (pairs with zuma-husky-drm.dtb). Layer after husky.config:
#   make zumapro_defconfig husky.config husky-drm.config
# No zumapro_bootfb, and exynos DRM's DECON quiesce stays on: the DPU SysMMU
# must not be enabled under the bootloader's running DECON.
# exynosdrm.oneshot=0: keep the DECON trigger armed so every TE re-sends the
# frame; fbcon draws without atomic commits, and in one-shot mode the panel
# froze after the first frame.
CONFIG_CMDLINE="arm64.nomte id_aa64mmfr1.vh=0 reboot=warm exynosdrm.oneshot=0 console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=font:TER16x32 rdinit=/init panic=0"
