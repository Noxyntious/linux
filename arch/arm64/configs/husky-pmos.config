# Pixel 8 Pro (husky) for postmarketOS: layer last,
#   make zumapro_defconfig husky.config husky-drm.config husky-pmos.config
# Adds what pmaports' kconfigcheck.toml (default + most community categories)
# wants, and a quieter cmdline: pmOS's initramfs is /init (no rdinit), and its
# splash shares the panel with fbcon, so keep the console but drop loglevel 8.
CONFIG_CMDLINE="arm64.nomte id_aa64mmfr1.vh=0 reboot=warm exynosdrm.oneshot=0 console=tty0 loglevel=4 fbcon=font:TER16x32 panic=5"
CONFIG_LOCALVERSION="-husky-pmos"

# category:default
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_BPF_LSM=y

# zram (pmOS enables zram swap by default)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y

# nftables / firewall / containers / waydroid
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_DUMMY=m
CONFIG_VXLAN=m
CONFIG_IPVLAN=m
CONFIG_VLAN_8021Q=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_WIREGUARD=m
CONFIG_UCLAMP_TASK_GROUP=y

# iwd / NetworkManager crypto
CONFIG_CRYPTO_CMAC=m
CONFIG_CRYPTO_DES=m
CONFIG_CRYPTO_MD4=m
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m

# filesystems (USB sticks, SD readers, Flatpak/EROFS images)
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_UDF_FS=m
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_DM_INTEGRITY=m

# USB host peripherals
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_NET_RNDIS_HOST=m

# LEDs (feedbackd)
CONFIG_LEDS_TRIGGER_PATTERN=m
CONFIG_LEDS_TRIGGER_TIMER=m
