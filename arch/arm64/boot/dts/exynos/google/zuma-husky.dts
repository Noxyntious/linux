// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 8 Pro (husky), Tensor G3 (zuma). First bring-up DT.
 *
 * Deliberately minimal: storage (UFS), USB gadget, keys and the watchdogs,
 * with the bootloader's framebuffer taken over by zumapro-bootfb (it reads
 * DECON back, so it needs no address here; pass "zumapro_bootfb" on the
 * command line). No PMIC, charger, panel or touch driver is bound yet, so
 * no regulator can be switched off behind the bootloader's back: every rail
 * a consumer needs is a fixed placeholder that is assumed to be on.
 *
 * Board facts from downstream kernel/devices/google/shusky
 * (android-gs-shusky-6.1-android16): zuma-husky-mp.dts board_id 0x40206,
 * zuma-shusky-usb.dtsi (eUSB2 repeater at 0x3e on hsi2c_11 and its tune
 * values), zuma-ufs.dtsi (UFS VCC enable on gpp0-1).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/usb/pd.h>
#include "zumapro-pinctrl.h"
#include "zuma.dtsi"

/ {
	model = "Google Pixel 8 Pro";
	compatible = "google,husky", "google,zuma";

	/*
	 * Read by the bootloader (not the kernel) to pick a DTB out of
	 * vendor_kernel_boot: zuma is product 0x9865, B0/B1 steppings, and
	 * IPOP (pkg_mode 1) or FOPLP (0) packages. Copied from downstream
	 * zuma-b0-ipop.dts / zuma-b0-foplp.dts so any retail unit matches.
	 */
	soc_compatible {
		B0_IPOP {
			description = "B0,IPOP";
			product_id = <0x09865>;
			major = <0x1>;
			minor = <0x0>;
			pkg_mode = <0x1>;
		};

		B1_IPOP {
			description = "B1,IPOP";
			product_id = <0x09865>;
			major = <0x1>;
			minor = <0x1>;
			pkg_mode = <0x1>;
		};

		B0_FOPLP {
			description = "B0,FOPLP";
			product_id = <0x09865>;
			major = <0x1>;
			minor = <0x0>;
			pkg_mode = <0x0>;
		};

		B1_FOPLP {
			description = "B1,FOPLP";
			product_id = <0x09865>;
			major = <0x1>;
			minor = <0x1>;
			pkg_mode = <0x0>;
		};
	};

	aliases {
		serial0 = &serial_0;
	};

	chosen {
		/*
		 * The bootloader crashes when /chosen/bootargs is absent, and it
		 * appends the boot image's command line to whatever is here, so
		 * keep it present and empty.
		 */
		bootargs = "";
		stdout-path = &serial_0;
	};

	/*
	 * No memory nodes here beyond zumapro.dtsi's memory@80000000: the
	 * bootloader adds memory@880000000 .. memory@a80000000 itself (as on
	 * stock, whose base DTB only has memory@80000000), and fails the boot
	 * when a node by that name already exists.
	 */

	/*
	 * Every hole the stock Android kernel leaves in low RAM on this phone
	 * (Evolution X 17 / CP2A.260805.005, /proc/iomem and /sys/firmware/fdt
	 * read back on a running husky) that zumapro.dtsi does not already
	 * reserve and that the bootloader does not add by itself. It adds
	 * sec_dram (0xb6200000), sec_pt (0xe0000000) and pkvm_guest_firmware
	 * (0x8b000000) to /reserved-memory on every boot, and refuses the DTB
	 * (reboots into fastboot) when they are already described here.
	 */
	reserved-memory {

		gxp_scratchpad@91300000 {
			reg = <0x0 0x91300000 0x000a0000>;
			no-map;
		};

		gxp@91400000 {
			reg = <0x0 0x91400000 0x01000000>;
			no-map;
		};

		carveout@97000000 {
			reg = <0x0 0x97000000 0x00400000>;
			no-map;
		};


		carveout@d8100000 {
			reg = <0x0 0xd8100000 0x02910000>;
			no-map;
		};

		carveout@dda10000 {
			reg = <0x0 0xdda10000 0x00610000>;
			no-map;
		};

	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
		};
	};

	reg_placeholder: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "placeholder_reg";
		regulator-always-on;
	};

	ufs_0_fixed_vcc_reg: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		/* nothing claims it, so only always-on stops the unused sweep */
		regulator-always-on;
		enable-active-high;
	};
};

/* The DSU covers all nine cores. */
&{/pmu-3} {
	cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
	       <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>, <&cpu8>;
};

&pinctrl_gpio_alive {
	key_power: key-power-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa6-2";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&ext_24_5m {
	clock-frequency = <24576000>;
};

&ext_200m {
	clock-frequency = <200000000>;
};

&ext_26m {
	clock-frequency = <26000000>;
};

&ext_1m {
	clock-frequency = <1000000>;
};

&serial_0 {
	status = "okay";
};

&watchdog_cl0 {
	timeout-sec = <30>;
	status = "okay";
};

&watchdog_cl1 {
	timeout-sec = <30>;
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	vdd-hba-supply = <&reg_placeholder>;
	vccq-supply = <&reg_placeholder>;
	vccq2-supply = <&reg_placeholder>;
	vcc-max-microamp = <0>;
	vccq-max-microamp = <0>;
	vccq2-max-microamp = <0>;

	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/* eUSB2 repeater: husky has it on hsi2c_11 (komodo: hsi2c_9). */
&usi11 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_11 {
	status = "okay";

	eusb_repeater: eusb-repeater@3e {
		compatible = "samsung,eusb-repeater";
		reg = <0x3e>;
		#phy-cells = <0>;
		vdd33-supply = <&reg_placeholder>;
		/* zuma-shusky-usb.dtsi repeater_tune1..8 (register, value) */
		samsung,tune-param = <0x50 0x0a>,
				     <0x70 0x3c>,
				     <0x71 0x2c>,
				     <0x72 0x90>,
				     <0x73 0x83>,
				     <0x77 0x00>,
				     <0x78 0x0b>,
				     <0x79 0x40>;
	};
};

/*
 * Peripheral only for now: the role switch normally comes from the
 * MAX77759 TCPC, which is not described yet.
 */
&usbdrd31 {
	vdd10-supply = <&reg_placeholder>;
	vdd33-supply = <&reg_placeholder>;

	status = "okay";
};

&usbdrd31_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	maximum-speed = "high-speed";

	status = "okay";

	port {
		usbdrd31_dwc3_role_switch: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbdrd31_phy {
	pll-supply = <&reg_placeholder>;
	dvdd-usb20-supply = <&reg_placeholder>;
	vddh-usb20-supply = <&reg_placeholder>;
	vdd33-usb20-supply = <&reg_placeholder>;
	vdda-usbdp-supply = <&reg_placeholder>;
	vddh-usbdp-supply = <&reg_placeholder>;
	orientation-switch;

	status = "okay";

	port {
		usbdrd31_phy_orien_switch: endpoint {
			remote-endpoint = <&usbc0_orien_sw>;
		};
	};
};

/*
 * The bootloader merges its DPM (debug policy) overlay onto &dpm and reboots
 * into fastboot when the base DTB has no such label: copied from the stock
 * husky DTB (vendor_kernel_boot, B FOPLP). This DTB is built with -@ so the
 * label is exported in /__symbols__.
 */
/ {
	dpm: dpm {
		version = <0x65>;
		variant = "user";

		security {
			cp_mem_not_clear = <0x00>;
			dbg_mem_enable = <0x00>;
			seh_enable = <0x00>;
			pm_test_enable = <0x00>;
			seclog_enable = <0x00>;
			harxlog_enable = <0x00>;
			sdm_enable = <0x00>;
			ERXPFG_enable = <0x00>;
		};

		abl {
			ramdump_mode = <0x00>;
			ramdump2usb = <0x00>;
		};

		feature {

			dump-mode {
				enabled = <0x01>;
				file-support = <0x00>;
			};

			event {
				method = "task_log", "work_log", "cpuidle_log", "suspend_log", "irq_log", "hrtimer_log", "clk_log", "pmu_log", "freq_log", "dm_log", "regulator_log", "thermal_log", "acpm_log", "printk_log";
			};

			debug-kinfo {
				enabled = <0x01>;
			};
		};

		policy {

			exception {
				pre_log = <0x01>;
				el1_da = <0x00>;
				el1_ia = <0x00>;
				el1_undef = <0x00>;
				el1_sp_pc = <0x00>;
				el1_inv = <0x00>;
				el1_serror = <0x00>;
			};
		};
	};
};

/*
 * The boot framebuffer is scanned out by the bootloader's DECON through the
 * DPUF read DMA. Nothing in this DT binds the display yet, so the DPU SysMMU
 * and S2MPU runtime-suspend about a second into boot and genpd powers their
 * domains off -- DECON stops fetching and the panel freezes on whatever it
 * showed last (and touching 0x19840000 afterwards hangs the bus). Keep the
 * display domains up until a real display driver owns them.
 */
&pd_dpub {
	samsung,always-on;
};

&pd_dpuf0 {
	samsung,always-on;
};

&pd_dpuf1 {
	samsung,always-on;
};

/*
 * Main PMIC (S2MPG14), only the two touch rails for now. Every other rail is
 * left as the bootloader set it: describing a regulator lets Linux set its
 * voltage, so nothing is listed without husky's own constraints. Values from
 * downstream zuma-husky-touch.dtsi; the IRQ is IRQB_M (SPI 75), as on the
 * Pixel 9 boards (identical interrupt map).
 */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH 0>;

		regulators {
			m_ldo4_reg: ldo4m {
				/* L4M_TS_AVDD: touch analog */
				regulator-name = "vdd_ts_avdd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			m_ldo25_reg: ldo25m {
				/* L25M_TSP_DVDD: touch digital */
				regulator-name = "vdd_ts_dvdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};

	/*
	 * Sub PMIC (S2MPG15), only the AoC sensor rails. Enable-only, like on
	 * the Pixel 9: the bootloader leaves the voltages where the AoC wants
	 * them (stock husky overlay: L7S_SENSORS 1.8 V, L5S_PROX 3.3 V).
	 * Same IRQ as on the Pixel 9 (gpa0-1).
	 */
	pmic-2 {
		compatible = "samsung,s2mpg15-pmic";
		interrupt-parent = <&gpa0>;
		interrupts = <1 0 0>, <1 0 1>;

		regulators {
			s_ldo5_reg: ldo5s {
				regulator-name = "L5S_PROX";
			};

			s_ldo7_reg: ldo7s {
				regulator-name = "L7S_SENSORS";
			};

			s_ldo12_reg: ldo12s {
				regulator-name = "L12S_CAMIO";	/* 1.85 V */
			};

			s_ldo26_reg: ldo26s {
				regulator-name = "L26S_LDAF";	/* 3.3 V */
			};
		};

		s2mpg15_gpio: gpio {
			compatible = "samsung,s2mpg15-gpio";
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

/*
 * Touch: ST FTM5 on USI20 SPI (downstream zuma-fts-touch.dtsi,
 * zuma-husky-touch.dtsi): IRQ gpn0-0, reset gpp21-2 (low = reset),
 * 10 MHz, sensor inverted in X and Y.
 */
&pinctrl_gpio_custom_alive {
	ts_irq: ts-irq {
		samsung,pins = "gpn0-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&usi20 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_20 {
	status = "okay";
	/*
	 * No pinctrl: on husky the USI20 SPI pins are dedicated (the vendor DT
	 * has an empty pinctrl-0). spi2_bus/spi2_cs_func would mux gpp4-0..3,
	 * which are the front camera's I2C, its reset and a GPS line here.
	 */
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	num-cs = <1>;

	touch: touchscreen@0 {
		compatible = "st,ftm5";
		reg = <0>;
		spi-max-frequency = <10000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq>;
		interrupts-extended = <&gpn0 0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp21 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&m_ldo25_reg>;
		avdd-supply = <&m_ldo4_reg>;
		touchscreen-size-x = <1344>;
		touchscreen-size-y = <2992>;
		/*
		 * No inversion: the controller's axes match the panel scan. (It
		 * once looked inverted because the bootloader's 180 degree IDMA
		 * read was left on; exynos_dpu_dma now clears it.)
		 */

		controller-data {
			samsung,spi-feedback-delay = <0>;
			samsung,spi-chip-select-mode = <0>;
			cs-clock-delay = <2>;
		};
	};
};

/*
 * MAX77759 on hsi2c_11 (downstream live DT of a husky): core/charger @0x66
 * (IRQ gpa8-0), fuel gauge @0x36 (IRQ gpa7-7), TCPC @0x25 (IRQ gpa8-3).
 * Wiring after gs101-pixel-common.dtsi (Pixel 6 has the same MAX77759).
 *
 * Deliberately conservative first step:
 *  - USB-C dual-role with PD; OTG source limited to 5 V / 900 mA.
 *  - dwc3 role and PHY orientation follow the TCPC (high-speed only for now).
 *  - Charging limits below Google's (4.48 V top tier, temperature-tiered
 *    current): 4.40 V float, 2.0 A, since this charger driver does no
 *    temperature tiering.
 */
/ {
	battery: battery {
		compatible = "simple-battery";
		/* google,chg-battery-capacity 4950 mAh */
		charge-full-design-microamp-hours = <4950000>;
		voltage-max-design-microvolt = <4480000>;
		constant-charge-voltage-max-microvolt = <4400000>;
		constant-charge-current-max-microamp = <2000000>;
	};
};

&pinctrl_gpio_alive {
	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa8-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa7-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&hsi2c_11 {
	maxtcpci: usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa8 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";
		vbus-supply = <&chgin_otg>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			self-powered;
			op-sink-microwatt = <2600000>;
			/* OTG: the MAX77759 reverse boost, kept modest */
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			/* as gs101-pixel-common.dtsi (same charger) */
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)>;
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_orien_switch>;
					};
				};

				port@1 {
					reg = <1>;
					usbc0_role_sw: endpoint {
						remote-endpoint = <&usbdrd31_dwc3_role_switch>;
					};
				};
			};
		};
	};

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa7 7 IRQ_TYPE_LEVEL_LOW>;
		/* maxim,rsense-default 500 (10 uOhm units) */
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa8 0 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
		power-supplies = <&maxtcpci>;
		monitored-battery = <&battery>;

		chgin_otg: chgin-otg-regulator {
			regulator-name = "chgin-otg";
		};

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

/*
 * Wi-Fi: BCM4398 (rev 3 "d0", PCIe 14e4:4444) on PCIe channel 1. Pins from
 * the husky live DT: PERST gph3-0, CLKREQ gph3-1, WL_REG_ON gph3-4,
 * WL_DEV_WAKE gph3-5, WL_HOST_WAKE gpa5-1 (the Pixel 9a's is gpa5-3).
 * Gen3, as stock runs it.
 */
&pinctrl_hsi2 {
	wlan_pcie1_clkreq: wlan-pcie1-clkreq-pins {
		samsung,pins = "gph3-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <3>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <3>;
	};

	wlan_reg_on: wlan-reg-on-pins {
		samsung,pins = "gph3-4";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};

	wlan_dev_wake: wlan-dev-wake-pins {
		samsung,pins = "gph3-5";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <1>;
	};
};

&pinctrl_far_alive {
	wlan_host_wake: wlan-host-wake-pins {
		samsung,pins = "gpa5-1";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <1>;
	};
};

&pcie_1_phy {
	status = "okay";
};

&pcie_1 {
	pinctrl-names = "default";
	pinctrl-0 = <&wlan_pcie1_clkreq &wlan_reg_on &wlan_host_wake &wlan_dev_wake>;
	reset-gpios = <&gph3 0 GPIO_ACTIVE_HIGH>;		/* PERST */
	wlan-reg-on-gpios = <&gph3 4 GPIO_ACTIVE_HIGH>;		/* WLAN_EN */
	host-wake-gpios = <&gpa5 1 GPIO_ACTIVE_HIGH>;		/* WL_HOST_WAKE */
	device-wake-gpios = <&gph3 5 GPIO_ACTIVE_HIGH>;		/* WL_DEV_WAKE */
	max-link-speed = <3>;
	status = "okay";
};

/*
 * Audio: everything goes through the AOC (it runs its own firmware, loaded
 * and authenticated by the GSA), with two CS35L41 speaker amps on spi_19
 * (HSI0 USI1, as komodo). From downstream zuma-shusky-audio.dtsi:
 * left  @0: IRQ gpa5-2, reset gpp1-1, native CS;
 * right @1: IRQ gpa7-2, reset gph2-1, CS gpn1-0 (GPIO), "R" prefix.
 * Boost settings as downstream. VA (s_bucka, 1.8 V) and VP (VSYS) are left
 * as the bootloader set them.
 */
&aoc {
	/* stock husky AOC node: aoc-board-cfg "HK3" */
	aoc-board-id = <0x40202>;
	aoc-board-rev = <0x10000>;

	/*
	 * The AoC does not power its physical sensors itself; without these it
	 * enumerates only fused/software sensors (stock: sensor_power_list).
	 */
	sensor_1v8-supply = <&s_ldo7_reg>;
	sensor_3v3-supply = <&s_ldo5_reg>;
};

/ {
	aoc_sound: aoc-sound {
		compatible = "google,aoc-sound";
		aoc = <&aoc>;

		speakers {
			sound-dai = <&cs35l41_l 0>, <&cs35l41_r 0>;
		};
	};

	cs35l41_vp: regulator-cs35l41-vp {
		compatible = "regulator-fixed";
		regulator-name = "cs35l41-vp";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
	};
};

&pinctrl_peric0 {
	cam_front_mclk_on: cam-front-mclk-on-pins {
		samsung,pins = "gpp5-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <2>;
	};

	cam_front_mclk_off: cam-front-mclk-off-pins {
		samsung,pins = "gpp5-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <2>;
	};

	cam_front_i2c: cam-front-i2c-pins {
		samsung,pins = "gpp4-0", "gpp4-1";
		samsung,pin-function = <GS101_PIN_FUNC_3>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	cs35l41_l_rst: cs35l41-l-rst-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&usi24 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_19 {
	status = "okay";
	num-cs = <2>;
	cs-gpios = <0>, <&gpn1 0 GPIO_ACTIVE_LOW>;

	cs35l41_l: cs35l41@0 {
		compatible = "cirrus,cs35l41";
		reg = <0>;
		#sound-dai-cells = <1>;
		spi-max-frequency = <25000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cs35l41_l_rst>;
		interrupt-parent = <&gpa5>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_HIGH>;
		VA-supply = <&reg_placeholder>;
		VP-supply = <&cs35l41_vp>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <4>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-select = <4>;
		cirrus,gpio2-output-enable;
		cirrus,subsystem-id = "husky";

		controller-data {
			samsung,spi-feedback-delay = <1>;
			samsung,spi-chip-select-mode = <0>;
		};
	};

	cs35l41_r: cs35l41@1 {
		compatible = "cirrus,cs35l41";
		reg = <1>;
		#sound-dai-cells = <1>;
		sound-name-prefix = "R";
		spi-max-frequency = <25000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gph2 1 GPIO_ACTIVE_HIGH>;
		VA-supply = <&reg_placeholder>;
		VP-supply = <&cs35l41_vp>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <4>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-select = <4>;
		cirrus,gpio2-output-enable;
		cirrus,right-channel-amp;
		cirrus,subsystem-id = "husky";

		controller-data {
			samsung,spi-feedback-delay = <1>;
			samsung,spi-chip-select-mode = <2>;
		};
	};
};

/*
 * Bluetooth: the BCM4398's BT core on the APM USI1 internal UART
 * (serial_18), H4 with RTS/CTS. The UART has no pads of its own to mux:
 * uart18-bus (gpa3) is not the BT link on husky (gpa3-0/1 are a bit-bang
 * bus, gpa3-2 is ODPM vbatt), so serial_18 takes no pinctrl.
 * Power and wake lines from the stock "goog,nitrous" node: BT_REG_ON
 * gpn8-0, BT_DEV_WAKE gpn9-0, BT_HOST_WAKE gpn6-0. REG_ON reaches the
 * chip through a flip-flop clocked by bt-ble-dbo-le (gpp24-3), which has
 * to be pulsed after every REG_ON change (nitrous toggle_dbo_ff()).
 * btbcm loads brcm/BCM.hcd, the patchram the stock HAL uses.
 */
&pinctrl_gpio_custom_alive {
	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpn8-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	bt_dev_wake: bt-dev-wake-pins {
		samsung,pins = "gpn9-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	bt_host_wake: bt-host-wake-pins {
		samsung,pins = "gpn6-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
	};
};

&pinctrl_peric1 {
	bt_reg_on_latch: bt-reg-on-latch-pins {
		samsung,pins = "gpp24-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&usi18 {
	samsung,clkreq-on; /* needed for UART mode */
	status = "okay";
};

&serial_18 {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4390-bt";
		pinctrl-0 = <&bt_reg_on &bt_dev_wake &bt_host_wake &bt_reg_on_latch>;
		pinctrl-names = "default";
		shutdown-gpios = <&gpn8 0 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpn9 0 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpn6 0 GPIO_ACTIVE_HIGH>;
		reg-on-latch-gpios = <&gpp24 3 GPIO_ACTIVE_HIGH>;
		max-speed = <3000000>;
	};
};

/*
 * Sensors live behind the AoC's USF sensor hub. aoc-usf uploads the stock
 * registry scripts (google/usf/registry.manifest) stamped with the CDT from
 * /chosen/plat, and usf-iio exposes the sensors as IIO devices.
 */
/ {
	aoc_usf: aoc-usf {
		compatible = "google,aoc-usf";
		google,aoc = <&aoc>;
	};
};

/*
 * Haptics: Cirrus CS40L26A on hsi2c_0 @0x43 (stock zuma-husky overlay):
 * IRQ gpa6-3, reset gph2-3 (active low), trigger gph2-0. cs40l26-vibra drives
 * the ROM firmware; the IRQ and the RAM firmware are not used yet.
 */
&usi0 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_0 {
	clock-frequency = <1000000>;
	status = "okay";

	haptics@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		pinctrl-0 = <&hapt_amp_rst>;
		pinctrl-names = "default";
		reset-gpios = <&gph2 3 GPIO_ACTIVE_LOW>;
		/* boost limits from the stock husky DT */
		cirrus,bst-expl-mode-disable;
		cirrus,bst-ctl-microvolt = <11000000>;
		cirrus,bst-ipk-microamp = <2500000>;
	};
};

&pinctrl_hsi1 {
	hapt_amp_rst: hapt-amp-rst-pins {
		samsung,pins = "gph2-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

/*
 * Camera power (vendor DT, sensor@1 "dokkaebi" = front, I2C bus 2 @0x10).
 * SLG51002 camera PMIC on USI14 @0x75; its enables are S2MPG15 GPIOs 0/1/3.
 */
&usi14 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_14 {
	clock-frequency = <400000>;
	status = "okay";

	slg51002: pmic@75 {
		compatible = "dlg,slg51002";
		reg = <0x75>;
		dlg,cs-gpios = <&s2mpg15_gpio 0 GPIO_ACTIVE_HIGH>;
		dlg,bb-gpios = <&s2mpg15_gpio 1 GPIO_ACTIVE_HIGH>;
		dlg,buck-gpios = <&s2mpg15_gpio 3 GPIO_ACTIVE_HIGH>;

		regulators {
			slg_ldo1: ldo1 {
				regulator-name = "CAM_LDO1";
				regulator-min-microvolt = <2250000>;
				regulator-max-microvolt = <2250000>;
			};

			slg_ldo8: ldo8 {
				regulator-name = "CAM_LDO8";
				regulator-min-microvolt = <970000>;
				regulator-max-microvolt = <970000>;
			};

			slg_gpio3: gpio3 {
				regulator-name = "CAM_SW3";
			};
		};
	};
};

&usi2 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_2 {
	clock-frequency = <400000>;
	pinctrl-0 = <&cam_front_i2c>;
	status = "okay";

	/* Front camera ("dokkaebi"); power order and delays from the vendor DT. */
	cam_front: camera@10 {
		compatible = "google,pixel-cis-bringup";
		reg = <0x10>;
		pixel,supply-names = "ldo1", "ldo8", "ldo26s", "ldo12s", "sw3";
		pixel,supply-delays-us = <500 750 0 0 500>;
		ldo1-supply = <&slg_ldo1>;
		ldo8-supply = <&slg_ldo8>;
		ldo26s-supply = <&s_ldo26_reg>;
		ldo12s-supply = <&s_ldo12_reg>;
		sw3-supply = <&slg_gpio3>;
		enable-gpios = <&s2mpg15_gpio 4 GPIO_ACTIVE_HIGH>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
		/* 24.576 MHz oscclk: no PLL here divides to exactly 24 MHz */
		clock-frequency = <24576000>;
		pinctrl-names = "mclk_on", "mclk_off";
		pinctrl-0 = <&cam_front_mclk_on>;
		pinctrl-1 = <&cam_front_mclk_off>;
		reset-gpios = <&gpp4 2 GPIO_ACTIVE_LOW>;
		pixel,reset-delay-us = <8000>;
	};
};

/ {
	/* Camera front end (CSIS + PDMA @0x1c000000) power, for bring-up. */
	ispfe-bringup {
		compatible = "google,zuma-ispfe-bringup";
		/* PMU ISPFE_CONFIGURATION/STATUS (also mapped by pd_ispfe), isp-fe */
		reg = <0x0 0x15462480 0x8>,
		      <0x0 0x1c300000 0x100000>;
		power-domains = <&pd_ispfe>;
		clocks = <&cmu_top CLK_DOUT_CMU_ISPFE_NOC>;
	};
};

